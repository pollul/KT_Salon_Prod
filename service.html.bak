  <style>
    .services-header {
      background-color: #f8f9fa;
      padding: 60px 0;
      margin-bottom: 40px;
      text-align: center;
    }
    
    .services-header h1 {
      color: #333;
      font-family: 'Epilogue', sans-serif;
      font-weight: 600;
      margin-bottom: 20px;
    }
    
    .services-header p {
      color: #666;
      font-size: 1.2rem;
      max-width: 800px;
      margin: 0 auto;
    }
    
    .services-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 20px 60px;
    }
    
    .accordion-button {
      background-color: #f8f9fa !important;
      color: #333 !important;
      font-family: 'Epilogue', sans-serif;
      font-weight: 600;
      padding: 20px 30px;
      border-radius: 8px !important;
      margin-bottom: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    
    .accordion-button:not(.collapsed) {
      color: #000 !important;
      background-color: #e7f1ff !important;
    }
    
    .accordion-body {
      padding: 20px 30px;
      background-color: #fff;
      border-radius: 0 0 8px 8px;
    }
    
    .table {
      margin-bottom: 0;
    }
    
    .table td {
      padding: 15px 10px;
      vertical-align: middle;
      border-color: #eee;
    }
    
    .table h2 {
      font-family: 'Epilogue', sans-serif;
      font-size: 1.5rem;
      color: #333;
      margin: 20px 0 10px;
      padding-bottom: 10px;
      border-bottom: 2px solid #eee;
    }
    
    .service-name {
      font-weight: 600;
      font-size: 1.1rem;
    }
    
    .service-price {
      font-weight: 600;
      color: #000;
    }
    
    .service-time {
      color: #666;
    }
  </style>
</head>
<body>
  
