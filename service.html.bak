  <div class="services-header">
    <div class="container">
      <h1>Our Services</h1>
      <p>Experience luxury hair care at KT's Coiffure. Our team of professional stylists is dedicated to providing high-quality services tailored to your unique needs.</p>
    </div>
  </div>

  <div class="services-container">
    <div class="accordion" id="accordionExampleY">
      <!-- Hair Services -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingHair_Services">
          <button class="accordion-button" type="button" data-mdb-toggle="collapse" data-mdb-target="#collapseHair_Services" aria-expanded="true" aria-controls="collapseHair_Services">
            Hair Services
          </button>
        </h2>
        <div id="collapseHair_Services" class="accordion-collapse collapse show" aria-labelledby="headingHair_Services" data-mdb-parent="#accordionExampleY">
          <div class="accordion-body">
            <table class="table table-hover">
              <tbody>
                <tr><td colspan="3"><h2>Cuts</h2></td></tr>
                <tr>
                  <td class="service-name">Women's Haircut</td>
                  <td class="service-price">$45</td>
                  <td class="service-time">45 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Men's Haircut</td>
                  <td class="service-price">$30</td>
                  <td class="service-time">30 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Children's Haircut (Under 12)</td>
                  <td class="service-price">$25</td>
                  <td class="service-time">30 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Bang Trim</td>
                  <td class="service-price">$15</td>
                  <td class="service-time">15 minutes</td>
                </tr>
                
                <tr><td colspan="3"><h2>Color</h2></td></tr>
                <tr>
                  <td class="service-name">Root Touch-Up</td>
                  <td class="service-price">$65</td>
                  <td class="service-time">60 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">All-Over Color</td>
                  <td class="service-price">$85</td>
                  <td class="service-time">90 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Partial Highlights</td>
                  <td class="service-price">$95</td>
                  <td class="service-time">90 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Full Highlights</td>
                  <td class="service-price">$120</td>
                  <td class="service-time">120 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Balayage</td>
                  <td class="service-price">$150</td>
                  <td class="service-time">150 minutes</td>
                </tr>
                
                <tr><td colspan="3"><h2>Styling</h2></td></tr>
                <tr>
                  <td class="service-name">Blowout</td>
                  <td class="service-price">$40</td>
                  <td class="service-time">45 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Formal Style/Updo</td>
                  <td class="service-price">$75</td>
                  <td class="service-time">60 minutes</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      
      <!-- Nail Services -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingNail_Services">
          <button class="accordion-button collapsed" type="button" data-mdb-toggle="collapse" data-mdb-target="#collapseNail_Services" aria-expanded="false" aria-controls="collapseNail_Services">
            Nail Services
          </button>
        </h2>
        <div id="collapseNail_Services" class="accordion-collapse collapse" aria-labelledby="headingNail_Services" data-mdb-parent="#accordionExampleY">
          <div class="accordion-body">
            <table class="table table-hover">
              <tbody>
                <tr><td colspan="3"><h2>Manicure</h2></td></tr>
                <tr>
                  <td class="service-name">Basic Manicure</td>
                  <td class="service-price">$35</td>
                  <td class="service-time">45 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Gel Manicure</td>
                  <td class="service-price">$50</td>
                  <td class="service-time">60 minutes</td>
                </tr>
                
                <tr><td colspan="3"><h2>Pedicure</h2></td></tr>
                <tr>
                  <td class="service-name">Basic Pedicure</td>
                  <td class="service-price">$45</td>
                  <td class="service-time">45 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Deluxe Pedicure</td>
                  <td class="service-price">$65</td>
                  <td class="service-time">60 minutes</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      
      <!-- Facial Services -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingFacial_Services">
          <button class="accordion-button collapsed" type="button" data-mdb-toggle="collapse" data-mdb-target="#collapseFacial_Services" aria-expanded="false" aria-controls="collapseFacial_Services">
            Facial Services
          </button>
        </h2>
        <div id="collapseFacial_Services" class="accordion-collapse collapse" aria-labelledby="headingFacial_Services" data-mdb-parent="#accordionExampleY">
          <div class="accordion-body">
            <table class="table table-hover">
              <tbody>
                <tr>
                  <td class="service-name">Basic Facial</td>
                  <td class="service-price">$75</td>
                  <td class="service-time">60 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Deep Cleansing Facial</td>
                  <td class="service-price">$95</td>
                  <td class="service-time">75 minutes</td>
                </tr>
                <tr>
                  <td class="service-name">Anti-Aging Facial</td>
                  <td class="service-price">$120</td>
                  <td class="service-time">90 minutes</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

